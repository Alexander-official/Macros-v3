# Macros v3 — ortam değişkenleri. Kopyalayın: cp .env.example .env   (.env asla repoya girmez)

# Panel girişi
ADMIN_USER=admin
ADMIN_PASS=guclu-bir-sifre

# Ana panel (Marzban) — müşteri sub linklerinin geldiği panel. Boş bırakılabilir.
MARZBAN_URL=
MARZBAN_USER=
MARZBAN_PASS=

# Ek sub yolları (virgülle). /macros her zaman açıktır. Eski linkleriniz farklı bir yol
# kullanıyorsa ekleyin, ör: EXTRA_SUB_PATHS=mysub
EXTRA_SUB_PATHS=

# Opsiyonel Telegram izleme/yedek botu (bot.py)
BOT_TOKEN=
BOT_CHAT_ID=
